{
  "name": "algo",
  "version": "0.1.0",
  "description": "面试算法练习脚手架：C++ / ACM 模式本地题库工作流 + micro 编辑器配置",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "algo": "src/index.ts"
  },
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target=bun --minify --outfile=dist/algo.js src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
